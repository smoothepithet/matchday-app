# Copy this to .env in the same folder (self-host/.env is already covered
# by the repo's .gitignore .env / .env.* rule — never commit the real one).

# Hostname this stack is served under. Must resolve via your local DNS
# override to Traefik's LAN IP for local testing, and later match the
# Cloudflare Tunnel public hostname when you expose it externally — same
# hostname both times, so nothing else needs to change when you flip that
# switch.
APP_HOSTNAME=matchday.yourdomain.com

# Name of the Docker network your existing Traefik instance watches.
# Check with: docker network ls
TRAEFIK_NETWORK=traefik

# Postgres
POSTGRES_DB=matchday
POSTGRES_PASSWORD=changeme-generate-a-strong-password

# Low-privilege role PostgREST connects as (see init/00-roles.sh)
AUTHENTICATOR_PASSWORD=changeme-generate-a-strong-password

# Shared secret GoTrue signs JWTs with and PostgREST verifies them with.
# Generate with: openssl rand -base64 32
JWT_SECRET=changeme-at-least-32-random-bytes

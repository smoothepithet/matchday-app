# Copy this to .env in the same folder (self-host/.env is already covered
# by the repo's .gitignore .env / .env.* rule — never commit the real one).

# Backend hostname — used for local testing now, and this is also what
# the Cloudflare Tunnel Public Hostname will point at whenever this gets
# exposed beyond the LAN. wyrleyrockets.uk is reserved for the frontend
# (GitHub Pages) only — keeping the backend on shadowlan.org avoids
# needing Cloudflare API token permissions across two separate zones.
APP_HOSTNAME=matchday-api.shadowlan.org

# Name of the Docker network your existing Traefik instance watches.
# Check with: docker network ls
TRAEFIK_NETWORK=proxynet

# Name of the Traefik certresolver your other services already use for
# real Let's Encrypt certs via Cloudflare's DNS-01 challenge (check an
# existing container's labels, e.g. `docker inspect <name>` and look for
# traefik.http.routers.<x>.tls.certresolver=...). DNS-01 doesn't require
# inbound internet reachability, so this works identically for local
# testing now and once exposed via the Tunnel later — no plain-HTTP vs.
# HTTPS inconsistency between the two phases.
TRAEFIK_CERTRESOLVER=cloudflare

# Postgres. These two get embedded directly in a connection URI
# (postgres://user:PASSWORD@postgres:5432/...) in docker-compose.yml, so
# generate them with `openssl rand -hex 24` rather than base64 — hex is
# guaranteed not to contain characters (/, +, =) that would break URI
# parsing.
POSTGRES_DB=matchday
POSTGRES_PASSWORD=changeme-openssl-rand-hex-24

# Low-privilege role PostgREST connects as (see init/00-roles.sh)
AUTHENTICATOR_PASSWORD=changeme-openssl-rand-hex-24

# Shared secret GoTrue signs JWTs with and PostgREST verifies them with.
# Generate with: openssl rand -base64 32
JWT_SECRET=changeme-at-least-32-random-bytes

# Where daily Postgres backups are written on the host. Point this at
# your main protected array (parity-covered), NOT the appdata/cache
# pool the rest of this stack lives on — otherwise a single cache-pool
# failure takes out both the live database AND its backups at once,
# which defeats the point.
BACKUP_DIR=/mnt/user/backups/matchday-app
